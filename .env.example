# Copy this file to .env and fill in the two keys. Never commit .env.

# --- Required ---------------------------------------------------------------
# Model key. Default setup: a free Rapid Router key from https://rapidrouter.ai/dashboard/keys
# (An Anthropic key also works: see "Using Claude instead" below.)
ANTHROPIC_API_KEY=
# Search key from https://tavily.com (free tier available)
TAVILY_API_KEY=

# --- Model (defaults below are the tested, free setup) ------------------------
# Any endpoint that speaks the Anthropic Messages API. Empty = api.anthropic.com
ANTHROPIC_BASE_URL=https://rapidrouter.ai/api
LLM_MODEL=google/gemma-4-31b-it:free
# Small model for background fact extraction
FACT_MODEL=google/gemma-4-31b-it:free

# Using Claude instead (not tested by the author):
#   directly:          ANTHROPIC_BASE_URL=   LLM_MODEL=claude-sonnet-5-5   FACT_MODEL=claude-haiku-5-5
#   via Rapid Router:  LLM_MODEL=anthropic/claude-sonnet-5-5   FACT_MODEL=anthropic/claude-haiku-5-5

# --- Optional ---------------------------------------------------------------
# true = load the demo history from data/seed.json when the DB is empty
SEED_ON_START=false
PORT=3000
TIMEZONE=Asia/Kolkata
# ISO date e.g. 2026-11-12T10:00:00 (read in TIMEZONE) - overrides "today" for testing
FAKE_NOW=
DB_PATH=./data/recall.db
