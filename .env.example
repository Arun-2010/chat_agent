# Required
# An Anthropic key, or a key from any gateway that speaks the Anthropic Messages API (see ANTHROPIC_BASE_URL)
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional
# Leave empty for api.anthropic.com. For Rapid Router use https://rapidrouter.ai/api
ANTHROPIC_BASE_URL=
# Model ids as the provider names them. Via Rapid Router: anthropic/claude-sonnet-5-5 and anthropic/claude-haiku-5-5
LLM_MODEL=claude-sonnet-5-5
# Small model for background fact extraction
FACT_MODEL=claude-haiku-5-5
# true = load the demo history from data/seed.json when the DB is empty
SEED_ON_START=false
PORT=3000
TIMEZONE=Asia/Kolkata
# ISO date e.g. 2026-11-12T10:00:00 (read in TIMEZONE) - overrides "today" for testing
FAKE_NOW=
DB_PATH=./data/recall.db
